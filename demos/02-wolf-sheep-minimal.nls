; Demo 02: Minimal predator-prey model
breed [ wolves wolf ]
breed [ sheep a-sheep ]
sheep-own [ energy ]
wolves-own [ energy ]

to setup
  clear-all
  create-sheep 80 [
    setxy random-xcor random-ycor
    set energy 10
    set color white
  ]
  create-wolves 30 [
    setxy random-xcor random-ycor
    set energy 20
    set color red
  ]
  reset-ticks
end

to go
  ask sheep [
    rt random 360
    fd 1
    set energy energy - 1
    if energy <= 0 [ die ]
  ]
  ask wolves [
    rt random 360
    fd 1
    let prey one-of sheep-here
    if prey != nobody [
      ask prey [ die ]
      set energy energy + 5
    ]
    set energy energy - 1
    if energy <= 0 [ die ]
  ]
  tick
end
